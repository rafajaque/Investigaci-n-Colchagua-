let
    Binario = if RutaDatos = "" then Binary.FromText("", BinaryEncoding.Base64) else File.Contents(RutaDatos & "\Correlaciones.csv"),
    Csv = Csv.Document(Binario,[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
    Encabezados = Table.PromoteHeaders(Csv,[PromoteAllScalars=true]),
    Tipos = Table.TransformColumnTypes(Encabezados, {{"Estacion_comuna", type text}, {"Indicador", type text}, {"Resultado", type text}, {"N", Int64.Type}, {"Pearson", type number}, {"Spearman", type number}, {"LOO_min", type number}, {"LOO_max", type number}, {"r_sin_2019_2021", type number}}, "en-US")
in Tipos