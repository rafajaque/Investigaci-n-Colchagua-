let
    Binario = if RutaDatos = "" then Binary.FromText("", BinaryEncoding.Base64) else File.Contents(RutaDatos & "\FactSector.csv"),
    Csv = Csv.Document(Binario,[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
    Encabezados = Table.PromoteHeaders(Csv,[PromoteAllScalars=true]),
    Tipos = Table.TransformColumnTypes(Encabezados, {{"Anio", Int64.Type}, {"CUT", type text}, {"Comuna", type text}, {"Sector", type text}, {"Empresas", Int64.Type}, {"Ventas_UF_observadas", type number}, {"Celdas_ventas_suprimidas", Int64.Type}}, "en-US")
in Tipos