let
    Binario = if RutaDatos = "" then Binary.FromText("", BinaryEncoding.Base64) else File.Contents(RutaDatos & "\FactClima.csv"),
    Csv = Csv.Document(Binario,[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
    Encabezados = Table.PromoteHeaders(Csv,[PromoteAllScalars=true]),
    Tipos = Table.TransformColumnTypes(Encabezados, {{"Fecha", type datetime}, {"Anio", Int64.Type}, {"CUT", type text}, {"Comuna", type text}, {"Estacion", type text}, {"Codigo_DMC", Int64.Type}, {"Lluvia_mm", type number}, {"Max24h_mm", type number}, {"Pagina_PDF", Int64.Type}, {"Fuente", type text}, {"Estado", type text}}, "en-US")
in Tipos