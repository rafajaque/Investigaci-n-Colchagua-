let
    Binario = if RutaDatos = "" then Binary.FromText("", BinaryEncoding.Base64) else File.Contents(RutaDatos & "\DimFecha.csv"),
    Csv = Csv.Document(Binario,[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
    Encabezados = Table.PromoteHeaders(Csv,[PromoteAllScalars=true]),
    Tipos = Table.TransformColumnTypes(Encabezados, {{"Fecha", type datetime}, {"Anio", Int64.Type}, {"Mes", Int64.Type}, {"AnioMes", type text}}, "en-US")
in Tipos