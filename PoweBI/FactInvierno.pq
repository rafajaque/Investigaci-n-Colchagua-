let
    Binario = if RutaDatos = "" then Binary.FromText("", BinaryEncoding.Base64) else File.Contents(RutaDatos & "\FactInvierno.csv"),
    Csv = Csv.Document(Binario,[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
    Encabezados = Table.PromoteHeaders(Csv,[PromoteAllScalars=true]),
    Tipos = Table.TransformColumnTypes(Encabezados, {{"Anio", Int64.Type}, {"CUT", type text}, {"Comuna", type text}, {"Lluvia_JJA", type number}, {"Max24h_JJA", type number}, {"Meses_validos", Int64.Type}, {"Referencia_2017_2022", type number}, {"Anomalia_lluvia", type number}}, "en-US")
in Tipos