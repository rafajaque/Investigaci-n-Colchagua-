let
    Binario = if RutaDatos = "" then Binary.FromText("", BinaryEncoding.Base64) else File.Contents(RutaDatos & "\SerieForecast.csv"),
    Csv = Csv.Document(Binario,[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
    Encabezados = Table.PromoteHeaders(Csv,[PromoteAllScalars=true]),
    Tipos = Table.TransformColumnTypes(Encabezados, {{"Fecha", type datetime}, {"Real", type number}, {"Pronostico", type number}, {"LI95", type number}, {"LS95", type number}, {"Modelo", type text}}, "en-US")
in Tipos