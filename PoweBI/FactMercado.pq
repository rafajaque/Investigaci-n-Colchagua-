let
    Binario = if RutaDatos = "" then Binary.FromText("", BinaryEncoding.Base64) else File.Contents(RutaDatos & "\FactMercado.csv"),
    Csv = Csv.Document(Binario,[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
    Encabezados = Table.PromoteHeaders(Csv,[PromoteAllScalars=true]),
    Tipos = Table.TransformColumnTypes(Encabezados, {{"Temporada", type text}, {"Producto", type text}, {"Toneladas", type number}, {"USD_FOB", type number}, {"USD_kg", type number}, {"Cuota_China_valor", type number}, {"Cambio_valor_unitario", type number}}, "en-US")
in Tipos