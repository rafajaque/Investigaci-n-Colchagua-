let
    Binario = if RutaDatos = "" then Binary.FromText("", BinaryEncoding.Base64) else File.Contents(RutaDatos & "\FactCultivo.csv"),
    Csv = Csv.Document(Binario,[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
    Encabezados = Table.PromoteHeaders(Csv,[PromoteAllScalars=true]),
    Tipos = Table.TransformColumnTypes(Encabezados, {{"CUT", type text}, {"Comuna", type text}, {"Especie", type text}, {"Riego", type text}, {"Hectareas", type number}, {"Anio", Int64.Type}}, "en-US")
in Tipos