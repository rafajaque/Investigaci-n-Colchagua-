let
    Binario = if RutaDatos = "" then Binary.FromText("", BinaryEncoding.Base64) else File.Contents(RutaDatos & "\FactPrioridad.csv"),
    Csv = Csv.Document(Binario,[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
    Encabezados = Table.PromoteHeaders(Csv,[PromoteAllScalars=true]),
    Tipos = Table.TransformColumnTypes(Encabezados, {{"Comuna", type text}, {"Ha_frutales", type number}, {"HHI_cultivos", type number}, {"Cuota_cerezo", type number}, {"Cuota_riego_gravedad", type number}, {"Empresas_total", Int64.Type}, {"Empresas_agro", Int64.Type}, {"Empresas_red_potencial", Int64.Type}, {"PYME_total_comuna", type number}, {"Micro_total_comuna", type number}, {"Dependencia_agro", type number}, {"CUT", type text}, {"Indice_prioridad", type number}, {"Puesto", Int64.Type}, {"Mejor_puesto", Int64.Type}, {"Peor_puesto", Int64.Type}, {"Top3_escenarios", Int64.Type}, {"Cluster", Int64.Type}, {"Accion", type text}}, "en-US")
in Tipos